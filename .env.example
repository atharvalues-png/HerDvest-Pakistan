# Public base URL used for metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Server-side only. Endpoint that receives form submissions (CRM webhook, form service, etc.).
# Until set, forms show an honest "not yet connected" message and nothing is sent.
FORM_WEBHOOK_URL=
# Optional bearer token sent to the webhook.
FORM_WEBHOOK_SECRET=
