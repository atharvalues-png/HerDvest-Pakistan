# ─── Public website ──────────────────────────────────────────────────────────
# Public base URL used for metadata, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ─── Database (required for the management system and enquiry queue) ───────
# Application connection — MUST use the non-privileged role "herdvest_app".
# Row-level security only protects data when the app connects as this role.
DATABASE_URL=postgres://herdvest_app:CHANGE_ME_LONG_RANDOM_PASSWORD@db-host:5432/herdvest
# Admin/owner connection — used ONLY by scripts/migrate.mjs and scripts/create-admin.mjs.
# Never give this to the running web app.
DATABASE_ADMIN_URL=postgres://postgres:ADMIN_PASSWORD@db-host:5432/herdvest
# "true" for managed databases that require TLS (Supabase, Neon, RDS …)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Session length for staff sign-in (hours)
SESSION_HOURS=12
# Fallback business timezone (the live value is set in Management → Settings)
BUSINESS_TIMEZONE=Asia/Karachi

# ─── Private file storage ────────────────────────────────────────────────────
# Directory OUTSIDE the web root on a persistent volume. Not suitable for
# serverless hosts — see README "File storage".
FILE_STORAGE_DIR=/var/lib/herdvest/storage

# ─── Optional: enquiry forwarding & notifications ───────────────────────────
# Forward website enquiries to a CRM / form service as well as the database.
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
# Email alert to the company inbox when an enquiry arrives (Resend API).
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_FROM_EMAIL=

# ─── Optional: automated intake (NOT active until configured and tested) ───
# Inbound email provider → POST /api/intake/email with "Authorization: Bearer <secret>"
INTAKE_WEBHOOK_SECRET=
# Comma-separated list of trusted senders; others are flagged in the review queue
INTAKE_ALLOWED_SENDERS=
# WhatsApp Business Platform (Cloud API) webhook → /api/intake/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
